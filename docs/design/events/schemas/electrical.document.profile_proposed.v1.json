{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.platform/electrical.document.profile_proposed.v1.json",
  "title": "electrical.document.profile_proposed.v1 data",
  "type": "object",
  "required": [
    "document_id",
    "job_id",
    "confidence",
    "needs_confirmation",
    "mixed_standards"
  ],
  "properties": {
    "document_id": {
      "type": "string",
      "format": "uuid"
    },
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "needs_confirmation": {
      "type": "boolean"
    },
    "mixed_standards": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
