{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.platform/knowledge.summary.built.v1.json",
  "title": "knowledge.summary.built.v1 data",
  "type": "object",
  "required": ["job_id", "document_id", "kind", "lang"],
  "properties": {
    "job_id": { "type": "string", "format": "uuid" },
    "document_id": { "type": "string", "format": "uuid" },
    "kind": { "type": "string", "enum": ["overview", "full"] },
    "lang": { "type": "string", "enum": ["auto", "ar", "en"] }
  },
  "additionalProperties": false
}
