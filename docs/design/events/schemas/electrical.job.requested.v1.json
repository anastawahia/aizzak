{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.platform/electrical.job.requested.v1.json",
  "title": "electrical.job.requested.v1 data",
  "type": "object",
  "required": [
    "job_id",
    "document_id",
    "reason"
  ],
  "properties": {
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "document_id": {
      "type": "string",
      "format": "uuid"
    },
    "reason": {
      "type": "string",
      "enum": [
        "resume",
        "reprocess",
        "confirmation"
      ]
    }
  },
  "additionalProperties": false
}
