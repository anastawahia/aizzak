{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.platform/files.file.uploaded.v1.json",
  "title": "files.file.uploaded.v1 data",
  "type": "object",
  "required": ["file_id", "content_type", "size_bytes", "storage_key"],
  "properties": {
    "file_id": { "type": "string", "format": "uuid" },
    "content_type": { "type": "string" },
    "size_bytes": { "type": "integer", "minimum": 0 },
    "storage_key": { "type": "string", "description": "workspace_id/uuid in MinIO" },
    "checksum": { "type": "string" },
    "space_id": {
      "type": "string",
      "format": "uuid",
      "description": "the file's owning space; ABSENT when it has none (spaces plan step 8) — an added optional field, so the type stays v1"
    },
    "tags": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "system": { "type": "string", "minLength": 1, "maxLength": 128 },
        "equipment": { "type": "string", "minLength": 1, "maxLength": 128 },
        "department": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "description": "the file's classification tags (PLT-26); ABSENT when it has none, and an absent tag is absent from the object — never null. An added optional field, so the type stays v1"
    }
  },
  "additionalProperties": false
}
