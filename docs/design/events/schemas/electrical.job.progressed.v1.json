{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.platform/electrical.job.progressed.v1.json",
  "title": "electrical.job.progressed.v1 data",
  "type": "object",
  "required": [
    "job_id",
    "document_id",
    "seq",
    "stage",
    "done",
    "total",
    "failed",
    "needs_review"
  ],
  "properties": {
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "document_id": {
      "type": "string",
      "format": "uuid"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "stage": {
      "type": "string",
      "enum": [
        "classify"
      ]
    },
    "done": {
      "type": "integer",
      "minimum": 0
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "failed": {
      "type": "integer",
      "minimum": 0
    },
    "needs_review": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
