{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.platform/knowledge.summary.requested.v1.json",
  "title": "knowledge.summary.requested.v1 data",
  "type": "object",
  "required": ["job_id", "document_id", "kind", "lang"],
  "properties": {
    "job_id": { "type": "string", "format": "uuid" },
    "document_id": { "type": "string", "format": "uuid" },
    "kind": { "type": "string", "enum": ["overview", "full"] },
    "lang": { "type": "string", "enum": ["auto", "ar", "en"] },
    "conversation_id": {
      "type": "string",
      "format": "uuid",
      "description": "the thread this build was asked for inside; ABSENT when it was asked for outside one (`F-7`) — an added optional field, so the type stays v1"
    }
  },
  "additionalProperties": false
}
