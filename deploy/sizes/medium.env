# AIZZAK size: medium
# host: cpus=16 memory_gb=32 mode=gpu
# source: derived from large, measured in server-gpu-plan 7.3
# Use: docker compose --env-file .env --env-file deploy/sizes/medium.env ...  (--env-file alone skips .env)
# Overlays win over these values: docker-compose.gpu.yml pins embedding to 1 replica / 3g,
# docker-compose.test.yml pins postgres cpus. POSTGRES_CONFIG_FILE pointed at the data
# directory's own postgresql.conf (m-8) switches this size's Postgres tuning off too.
POSTGRES_CONFIG_FILE=/etc/postgresql/sizes/medium.conf
WAL_ARCHIVE_INIT_CPUS=0.25
WAL_ARCHIVE_INIT_MEM=128m
POSTGRES_CPUS=3.0
POSTGRES_MEM=4g
PGBOUNCER_CPUS=0.5
PGBOUNCER_MEM=256m
REDIS_STREAM_CPUS=0.5
REDIS_STREAM_MEM=1536m
REDIS_STREAM_MAXMEMORY=1gb
REDIS_CACHE_CPUS=0.5
REDIS_CACHE_MEM=896m
REDIS_CACHE_MAXMEMORY=128mb
MINIO_CPUS=0.5
MINIO_MEM=1g
QDRANT_CPUS=1.5
QDRANT_MEM=3g
EMBEDDING_CPUS=1.0
EMBEDDING_MEM=1280m
EMBEDDING_REPLICAS=2
EMBEDDING_LB_CPUS=0.25
EMBEDDING_LB_MEM=128m
VAULT_CPUS=0.5
VAULT_MEM=256m
VAULT_BOOTSTRAP_CPUS=0.25
VAULT_BOOTSTRAP_MEM=256m
MINIO_BOOTSTRAP_CPUS=0.25
MINIO_BOOTSTRAP_MEM=256m
MIGRATE_CPUS=1.0
MIGRATE_MEM=1g
OLLAMA_BRIDGE_CPUS=0.5
OLLAMA_BRIDGE_MEM=256m
OLLAMA_CPUS=2.0
OLLAMA_MEM=3g
OLLAMA_PULL_CPUS=0.25
OLLAMA_PULL_MEM=64m
APP_CPUS=1.0
APP_MEM=1536m
APP_REPLICAS=2
WORKER_MEMORY_CPUS=0.5
WORKER_MEMORY_MEM=1g
WORKER_KNOWLEDGE_CPUS=1.0
WORKER_KNOWLEDGE_MEM=2g
WORKER_KNOWLEDGE_REPLICAS=1
WORKER_MEDIA_CPUS=1.0
WORKER_MEDIA_MEM=1536m
OUTBOX_RELAY_CPUS=0.5
OUTBOX_RELAY_MEM=512m
OUTBOX_RELAY_REPLICAS=1
WAL_SHIPPER_CPUS=0.25
WAL_SHIPPER_MEM=256m
BACKUP_CPUS=1.0
BACKUP_MEM=1g
OPS_SCHEDULER_CPUS=0.5
OPS_SCHEDULER_MEM=512m
NGINX_CERTS_CPUS=0.25
NGINX_CERTS_MEM=128m
NGINX_CPUS=1.0
NGINX_MEM=256m
PROMETHEUS_CPUS=0.5
PROMETHEUS_MEM=768m
GRAFANA_CPUS=0.25
GRAFANA_MEM=512m
ALERTMANAGER_CPUS=0.25
ALERTMANAGER_MEM=64m
ALERT_SINK_CPUS=0.1
ALERT_SINK_MEM=32m
PGBOUNCER_EXPORTER_CPUS=0.1
PGBOUNCER_EXPORTER_MEM=64m
REDIS_STREAM_EXPORTER_CPUS=0.1
REDIS_STREAM_EXPORTER_MEM=64m
REDIS_CACHE_EXPORTER_CPUS=0.1
REDIS_CACHE_EXPORTER_MEM=64m
NODE_EXPORTER_CPUS=0.1
NODE_EXPORTER_MEM=64m
POSTGRES_EXPORTER_CPUS=0.1
POSTGRES_EXPORTER_MEM=64m
CADVISOR_CPUS=0.5
CADVISOR_MEM=512m
LOKI_CPUS=0.5
LOKI_MEM=512m
ALLOY_CPUS=0.25
ALLOY_MEM=256m
K6_CPUS=2.0
K6_MEM=2g
