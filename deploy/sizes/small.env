# AIZZAK size: small
# host: cpus=8 memory_gb=16 mode=gpu
# source: derived from large, measured in server-gpu-plan 7.3 (experiment only: caps below measured peaks, OOMKilled accepted, ق-0)
# Use: docker compose --env-file .env --env-file deploy/sizes/small.env ...  (--env-file alone skips .env)
# Overlays win over these values: docker-compose.gpu.yml pins embedding to 1 replica / 3g,
# docker-compose.test.yml pins postgres cpus. POSTGRES_CONFIG_FILE pointed at the data
# directory's own postgresql.conf (m-8) switches this size's Postgres tuning off too.
POSTGRES_CONFIG_FILE=/etc/postgresql/sizes/small.conf
WAL_ARCHIVE_INIT_CPUS=0.25
WAL_ARCHIVE_INIT_MEM=128m
POSTGRES_CPUS=2.0
POSTGRES_MEM=1536m
PGBOUNCER_CPUS=0.25
PGBOUNCER_MEM=128m
REDIS_STREAM_CPUS=0.25
REDIS_STREAM_MEM=384m
REDIS_STREAM_MAXMEMORY=256mb
REDIS_CACHE_CPUS=0.25
REDIS_CACHE_MEM=896m
REDIS_CACHE_MAXMEMORY=128mb
MINIO_CPUS=0.5
MINIO_MEM=512m
QDRANT_CPUS=1.0
QDRANT_MEM=768m
EMBEDDING_CPUS=1.0
EMBEDDING_MEM=1280m
EMBEDDING_REPLICAS=1
EMBEDDING_LB_CPUS=0.25
EMBEDDING_LB_MEM=64m
VAULT_CPUS=0.25
VAULT_MEM=256m
VAULT_BOOTSTRAP_CPUS=0.25
VAULT_BOOTSTRAP_MEM=256m
MINIO_BOOTSTRAP_CPUS=0.25
MINIO_BOOTSTRAP_MEM=256m
MIGRATE_CPUS=1.0
MIGRATE_MEM=1g
OLLAMA_BRIDGE_CPUS=0.5
OLLAMA_BRIDGE_MEM=256m
OLLAMA_CPUS=1.0
OLLAMA_MEM=1g
OLLAMA_PULL_CPUS=0.25
OLLAMA_PULL_MEM=64m
APP_CPUS=1.0
APP_MEM=1g
APP_REPLICAS=1
WORKER_MEMORY_CPUS=0.25
WORKER_MEMORY_MEM=384m
WORKER_KNOWLEDGE_CPUS=0.5
WORKER_KNOWLEDGE_MEM=1g
WORKER_KNOWLEDGE_REPLICAS=1
WORKER_MEDIA_CPUS=0.5
WORKER_MEDIA_MEM=1g
OUTBOX_RELAY_CPUS=0.25
OUTBOX_RELAY_MEM=256m
OUTBOX_RELAY_REPLICAS=1
WAL_SHIPPER_CPUS=0.1
WAL_SHIPPER_MEM=128m
BACKUP_CPUS=1.0
BACKUP_MEM=1g
OPS_SCHEDULER_CPUS=0.25
OPS_SCHEDULER_MEM=256m
NGINX_CERTS_CPUS=0.25
NGINX_CERTS_MEM=128m
NGINX_CPUS=0.5
NGINX_MEM=128m
PROMETHEUS_CPUS=0.25
PROMETHEUS_MEM=256m
GRAFANA_CPUS=0.1
GRAFANA_MEM=384m
ALERTMANAGER_CPUS=0.1
ALERTMANAGER_MEM=64m
ALERT_SINK_CPUS=0.1
ALERT_SINK_MEM=32m
PGBOUNCER_EXPORTER_CPUS=0.1
PGBOUNCER_EXPORTER_MEM=64m
REDIS_STREAM_EXPORTER_CPUS=0.1
REDIS_STREAM_EXPORTER_MEM=64m
REDIS_CACHE_EXPORTER_CPUS=0.1
REDIS_CACHE_EXPORTER_MEM=64m
NODE_EXPORTER_CPUS=0.1
NODE_EXPORTER_MEM=64m
POSTGRES_EXPORTER_CPUS=0.1
POSTGRES_EXPORTER_MEM=64m
CADVISOR_CPUS=0.5
CADVISOR_MEM=512m
LOKI_CPUS=0.25
LOKI_MEM=384m
ALLOY_CPUS=0.1
ALLOY_MEM=256m
K6_CPUS=2.0
K6_MEM=2g
