    {
      "id": 15,
      "type": "timeseries",
      "title": "SQLAlchemy pool (per app container, summed over siblings)",
      "description": "livesum across WEB_CONCURRENCY siblings -- a dead worker's last value must not keep counting against §3's connection budget. `overflow` rising above 0 means DB_POOL_SIZE is exhausted and connections are being opened beyond it; sustained overflow is the app-side half of ح-3.",
      "datasource": {
        "type": "prometheus",
        "uid": "aizzak-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "aizzak-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(aizzak_db_pool_in_use)",
          "legendFormat": "in use",
          "range": true,
          "instant": false,
          "refId": "R"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "aizzak-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(aizzak_db_pool_available)",
          "legendFormat": "available",
          "range": true,
          "instant": false,
          "refId": "S"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "aizzak-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(aizzak_db_pool_overflow)",
          "legendFormat": "overflow",
          "range": true,
          "instant": false,
          "refId": "T"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
