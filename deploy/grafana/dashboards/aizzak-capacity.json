        "type": "prometheus",
        "uid": "aizzak-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "aizzak-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(aizzak_http_requests_total{status=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "5xx (errors)",
          "range": true,
          "instant": false,
          "refId": "K"
