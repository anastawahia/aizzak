            "uid": "aizzak-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(aizzak_http_requests_total{status=~\"4..\",status!=\"429\"}[$__rate_interval]))",
          "legendFormat": "4xx (client)",
          "range": true,
          "instant": false,
          "refId": "L"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "aizzak-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(aizzak_rate_limit_rejections_total[$__rate_interval]))",
