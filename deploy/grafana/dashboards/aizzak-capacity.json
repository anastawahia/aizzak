{
  "uid": "aizzak-capacity",
  "title": "AIZZAK — capacity (Wave 0)",
  "description": "The one dashboard Wave 0 step 0.3 asks for: RED, pools, stream lag and DLQ depth, plus the saturation signals that say WHY. Provisioned from deploy/grafana/dashboards/aizzak-capacity.json and not editable in the browser -- step 0.5's baseline has to be reproducible from a commit. Every panel's description names the plan item it exists for; hover the (i) rather than guessing what a line means.",
  "tags": [
    "aizzak",
    "capacity",
    "wave-0"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Is the platform up, and is anything alerting?",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Firing alerts",
      "description": "ALERTS is Prometheus's own series for rule state. 0 here means every rule in deploy/prometheus/alerts.yml evaluated and none matched -- not that the rules are missing, which would show as no data.",
      "datasource": {
        "type": "prometheus",
        "uid": "aizzak-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "aizzak-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(ALERTS{alertstate=\"firing\"}) or vector(0)",
          "legendFormat": "firing",
          "range": false,
          "instant": true,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
