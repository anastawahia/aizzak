    {
      "id": 10,
      "type": "timeseries",
      "title": "Request rate by route",
      "description": "§0's targets are 50 rps average and 300 rps peak, ACROSS all routes -- read the `total` series against those, not any single route. The route label is the template (/api/v1/spaces/{space_id}), never the raw path.",
      "datasource": {
        "type": "prometheus",
        "uid": "aizzak-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "aizzak-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (route) (rate(aizzak_http_requests_total[$__rate_interval]))",
          "legendFormat": "{{route}}",
          "range": true,
          "instant": false,
          "refId": "I"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "aizzak-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(aizzak_http_requests_total[$__rate_interval]))",
          "legendFormat": "total",
          "range": true,
          "instant": false,
          "refId": "J"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
