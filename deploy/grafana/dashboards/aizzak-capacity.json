    {
      "id": 12,
      "type": "timeseries",
      "title": "Latency percentiles — all routes",
      "description": "The histogram's buckets were placed ON 07-nfr-slo §2's budgets (0.15 read, 0.25 write, 1.2 TTFT), so these quantiles are exact AT those boundaries rather than interpolated near them -- which is the whole reason DURATION_BUCKETS is not the prometheus_client default. Threshold lines: 150ms read budget, 250ms write.",
      "datasource": {
        "type": "prometheus",
        "uid": "aizzak-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "aizzak-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(aizzak_http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50",
          "range": true,
          "instant": false,
          "refId": "N"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "aizzak-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(aizzak_http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true,
          "instant": false,
          "refId": "O"
        },
        {
          "datasource": {
