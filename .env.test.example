# Containerised integration-test harness.
# Copy to `.env.test`, replace every `change-me-*` value, then load it with:
#   set -a; . .env.test; set +a
#
# Read the local Vault root token from the persistent init volume:
#   docker run --rm -v aizzak_vault-init:/i alpine sh -c 'cat /i/init.json' | jq -r .root_token

TEST_DATABASE_URL=postgresql+asyncpg://aizzak_owner:change-me-owner@127.0.0.1:15432/aizzak_test
TEST_DATABASE_URL_APP=postgresql+asyncpg://app_rw:change-me-app@127.0.0.1:15432/aizzak_test
TEST_DATABASE_URL_RELAY=postgresql+asyncpg://outbox_relay:change-me-relay@127.0.0.1:15432/aizzak_test
TEST_DATABASE_URL_RETENTION=postgresql+asyncpg://retention_sweeper:change-me-retention@127.0.0.1:15432/aizzak_test
TEST_DATABASE_URL_METRICS=postgresql+asyncpg://metrics_reader:change-me-metrics@127.0.0.1:15432/aizzak_test
TEST_DATABASE_URL_TRANSIT_ROTATOR=postgresql+asyncpg://transit_rotator:change-me-rotator@127.0.0.1:15432/aizzak_test
TEST_DATABASE_URL_PURGER=postgresql+asyncpg://workspace_purger:change-me-purger@127.0.0.1:15432/aizzak_test
TEST_REDIS_URL=redis://127.0.0.1:16379/0
TEST_MINIO_ENDPOINT=127.0.0.1:19000
TEST_MINIO_ACCESS_KEY=aizzak_test
# If omitted, conftest falls back to `_MINIO_SECRET_DEFAULT`
# (`aizzak-test-secret`). After `.env` rotates `MINIO_TEST_SECRET_KEY`, copy
# that exact value here; otherwise live_minio fails with SignatureDoesNotMatch.
TEST_MINIO_SECRET_KEY=change-me-minio-test-secret
TEST_MINIO_BUCKET=aizzak-test
TEST_QDRANT_URL=http://127.0.0.1:16333
TEST_VAULT_ADDR=http://127.0.0.1:18200
TEST_VAULT_TOKEN=change-me-vault-root-token
TEST_EMBEDDING_URL=http://127.0.0.1:8080
TEST_OLLAMA_BASE_URL=http://127.0.0.1:11434
