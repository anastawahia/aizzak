# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment & secrets
.env
# Local live-test credentials.  This file contains database passwords and the
# Vault root token; only the redacted `.env.test.example` belongs in Git.
.env.test
# `.env` alone left every hand-made copy exposed: a `.env.bak.<stamp>` written
# before editing is untracked-but-not-ignored, so one `git add -A` commits all
# eight passwords. The whole class is ignored, not one stamp.
.env.bak*
.env.*.bak
.env.local
.env.save
*.local

# Build / dist
build/
dist/

# OS / IDE
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# Windows NTFS alternate data streams. Downloading any file with a Windows
# browser leaves a sibling `<name>:Zone.Identifier` stub next to it, visible
# from WSL as a real 25-byte file. `docs/ROADMAP.md:Zone.Identifier` reached
# the index that way (removed in step 6). The whole class is ignored, not
# that one path -- the next downloaded file would produce the next one.
*:Zone.Identifier

# Data / runtime
*.log

# Coverage output. `.coverage` is a local SQLite database rewritten by every
# `pytest --cov` run; it was tracked until step 6 and committed binary churn.
.coverage
.coverage.*
coverage.xml
htmlcov/

# TLS material for the local edge — generated by the nginx-certs one-shot
# service (7.3). Never committed: development keys, and a real deployment
# mounts its own.
deploy/nginx/certs/

# Claude Code worktrees: a full second copy of this repository lives under
# .claude/worktrees/<name>/ whenever a worktree session is open. 714 of those
# files were swallowed by the initial commit -- a nested duplicate of the
# project, tracked twice. The agent definitions in .claude/agents/ stay
# tracked; only the worktree copies are ignored.
.claude/worktrees/

# Load-harness artifacts (docs/capacity-plan.md 0.1). The token file holds
# REAL Firebase ID tokens -- credentials, not fixtures -- and the results
# directory is per-run output that belongs in an archive, not in history.
deploy/load/tokens.json
deploy/load/results/
