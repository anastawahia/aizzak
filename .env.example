# AIZZAK — non-secret configuration (05-rbac-config-secrets §2).
# Copy to .env and adjust. APPLICATION secrets are not set here — they live in
# Vault (Firebase SA, provider keys, tenant Transit key, and the MinIO keys the
# app reads at startup from secret/data/minio).
#
# ⚠️ The container BOOTSTRAP passwords below are the exception, and they are
# one by necessity, not by oversight: Postgres and MinIO must be started with
# a password before anything can read a password out of Vault. deploy/vault/
# bootstrap.sh seeds the very same values into Vault, which is the only copy
# `src/` ever reads. .env is gitignored; keep it that way.

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Database roles (01-data-model §3/§6). THREE roles, and the split is the
# tenant-isolation guarantee, not bookkeeping:
#   aizzak_owner  migrator + table owner. Runs Alembic and app.ops.provision.
#                 Never serves a request. Connects DIRECTLY to postgres:5432 —
#                 DDL under transaction pooling is a needless hazard.
#   app_rw        what the API and the Streams workers connect as. NOINHERIT,
#                 no BYPASSRLS, not an owner ⇒ the RLS policy confines it.
#                 Connects via PgBouncer (6432), never 5432.
#   outbox_relay  SELECT/UPDATE on platform.outbox and nothing else.
#   retention_sweeper  (P1-5, p1-hardening-plan.md §3 step 8) SELECT/DELETE on
#                 the three unbounded platform ledgers (outbox, processed_events,
#                 idempotency_keys) and nothing else -- run manually via
#                 `python -m app.ops.retention`, never a standing service.
#   metrics_reader  (P1-3, p1-hardening-plan.md §3 step 10) SELECT-only on
#                 platform.outbox and nothing else -- the `/metrics` endpoint's
#                 own read; app_rw is INSERT-only there. A standing consumer
#                 (the `app` service, every scrape), same footing as
#                 outbox_relay.
#   transit_rotator (P1-9, p1-hardening-plan.md §3 step 12) SELECT plus
#                 column-scoped UPDATE (the ciphertext column alone) on the
#                 three Transit-ciphertext-bearing tables and nothing else --
#                 run manually via `python -m app.ops.rotate_transit`, never
#                 a standing service, the retention_sweeper footing.
#   workspace_purger (BE-ADM-014) SELECT/DELETE on every tenant table a
#                 purged workspace's content lives in, plus column-scoped
#                 SELECT/UPDATE on workspace.workspaces/workspace.users and
#                 SELECT/INSERT on platform.admin_audit_log -- run manually
#                 via `python -m app.ops.purge`, never a standing service,
#                 the retention_sweeper/transit_rotator footing.
# Roles are created at cluster init (deploy/postgres/initdb/10-roles.sh);
# their GRANTs come from app.ops.provision after the migrations.
# ---------------------------------------------------------------------------
POSTGRES_DB=aizzak
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
AIZZAK_OWNER_PASSWORD=change-me-owner
APP_RW_PASSWORD=change-me-app
OUTBOX_RELAY_PASSWORD=change-me-relay
RETENTION_SWEEPER_PASSWORD=change-me-retention
METRICS_READER_PASSWORD=change-me-metrics
TRANSIT_ROTATOR_PASSWORD=change-me-rotator
WORKSPACE_PURGER_PASSWORD=change-me-purger
# backup_operator (capacity step 2.5): the eighth role, and the only one with
# REPLICATION and BYPASSRLS. `pg_basebackup` needs the first; the second is
# what stops `pg_dump` writing a dump with 202 workspaces and zero users in
# it (every tenant table is under FORCE ROW LEVEL SECURITY -- measured, see
# deploy/postgres/initdb/10-roles.sh).
BACKUP_OPERATOR_PASSWORD=change-me-backup

# Composed by docker-compose.yml per process from the passwords above; set
# explicitly only when running a process OUTSIDE Compose. asyncpg's
# statement_cache_size=0 (OPS-02) is enforced in create_engine for every
# engine, so it does not need to be in the URL.
# DATABASE_URL=postgresql+asyncpg://app_rw:change-me-app@pgbouncer:6432/aizzak
# The API SERVER's pool, and only its -- one of these per gunicorn sibling, so it
# multiplies with WEB_CONCURRENCY below. The three workers and the relay do NOT
# read it: they build their own 2+0 pools (`_WORKER_POOL_SIZE`/`_RELAY_POOL_SIZE`
# in app/workers/bootstrap.py) because each runs one statement at a time. The
# whole ledger is docs/design/08-local-runbook.md §2‑ب.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# MinIO. MINIO_ENDPOINT is where the SERVER reaches MinIO; MINIO_PUBLIC_ENDPOINT
# is what presigned URLs are SIGNED against. Inside Compose those differ:
# `minio:9000` resolves on the Docker network and nowhere else, and SigV4
# covers the host, so a URL signed against it cannot be repointed afterwards —
# not by Nginx, not by string surgery. Leave the public one empty for a
# single-address deployment and signing falls back to MINIO_ENDPOINT.
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=workspace-files
MINIO_SECURE=false
MINIO_PUBLIC_ENDPOINT=localhost:19000
MINIO_PUBLIC_SECURE=false
MINIO_ROOT_USER=change-me-minio
MINIO_ROOT_PASSWORD=change-me-minio-secret
# Capacity step 2.5. A SEPARATE bucket, versioned, and separate for a reason
# that is not tidiness: a policy or a mistake that empties the file bucket
# must not be able to empty the backups of it at the same time.
BACKUP_BUCKET=aizzak-backups
# How often `wal-shipper` drains the archive spool into that bucket. This is
# NOT the RPO -- `archive_timeout` in docker-compose.yml is (300s). This is
# how long a segment sits on the Postgres volume after being archived.
BACKUP_WAL_INTERVAL_S=30
# Days of noncurrent object versions MinIO keeps after this tool overwrites
# or deletes one. The tool's own `prune` owns CURRENT versions; this bounds
# what versioning keeps behind them (deploy/minio/bootstrap.sh).
BACKUP_NONCURRENT_DAYS=30
# Presigned-URL lifetimes, in seconds. PUT is longer than GET because the client
# still has to move the bytes; GET only has to be clicked. SigV4 accepts 1s..7d
# and nothing outside it, so an out-of-range value here fails the app at BOOT.
MINIO_PRESIGN_PUT_TTL_S=900
MINIO_PRESIGN_GET_TTL_S=300
# Live test harness only -- the bucket-scoped service account that
# `deploy/minio/bootstrap.sh` mints for the `live_minio` suite. LEAVE IT OFF
# HERE. A deployment has no business minting test credentials, nothing under
# `deploy/` sets these, and `docker-compose.yml` already defaults all four to
# exactly the values below -- so an absent line and `false` mean the same
# thing. A developer running the live suite copies this file to `.env` and
# flips the switch to `true` there; that copy is git-ignored.
MINIO_TEST_ACCOUNT_ENABLED=false
MINIO_TEST_BUCKET=aizzak-test
MINIO_TEST_ACCESS_KEY=aizzak_test
# NOT a deployment credential: this is only the checked-in placeholder for the
# bucket-scoped live-test account. The test harness independently falls back to
# this same literal through `tests/integration/conftest.py::_MINIO_SECRET_DEFAULT`
# when `TEST_MINIO_SECRET_KEY` is absent. A local `.env` may replace it with a
# unique value, but its ignored `.env.test` must then carry that exact value:
# without the file the suite reaches MinIO with the placeholder and fails
# loudly with SignatureDoesNotMatch; it does not skip. The two variable names
# are not linked structurally. The D-1 harness guard rejects a mismatch when
# both are configured; if TEST_MINIO_SECRET_KEY is absent, the placeholder
# fallback still reaches the rotated account and fails authentication loudly.
MINIO_TEST_SECRET_KEY=aizzak-test-secret

QDRANT_URL=http://qdrant:6333

# Central embedding service (2.10) -- internal only, the same trust boundary
# as Postgres/Redis/Qdrant above. Only the URL is env-editable (DD-11);
# model/dimensions/batch/timeout are pinned adapter-side defaults that must
# match services/embedding/Dockerfile's baked model.
EMBEDDING_SERVICE_URL=http://embedding:8080

# ---------------------------------------------------------------------------
# Vault (05 §3.3 · D-22 · release-blockers-plan.md §3 step 1). TWO
# authentication modes, and WHICH VARIABLES ARE SET is the switch --
# `create_vault_client` prefers a token whenever one is present, so an
# AppRole deployment must leave VAULT_TOKEN *blank*:
#
#   token   (a manual operator override — see below) VAULT_TOKEN=<root token>
#   AppRole (the normal case, including local dev)    VAULT_TOKEN=  (blank!)
#                                                      VAULT_ROLE_ID=<from vault>
#                                                      VAULT_SECRET_ID=<injected
#                                                        outside this file>
#
# ⚠️ VAULT_SECRET_ID must NEVER appear here. It is the one sensitive value in
# the environment (05 §3.3); pass it in the shell that runs `docker compose
# up`. role_id is non-secret by design and belongs in this file.
#
# ⚠️ Vault now persists (`storage "file"` on a named volume, not `-dev`) --
# there is no dev root token anymore. `deploy/vault/start.sh` mints the real
# root token via `operator init` on first boot and records it, with the
# unseal key, in the `vault-init` volume; `deploy/vault/bootstrap.sh` reads
# it from there itself. This is STILL only acceptable for a single local
# host: the unseal key sits in plaintext on that volume because there is no
# KMS here to auto-unseal against. See docs/quickstart.md §5.
# ---------------------------------------------------------------------------
VAULT_ADDR=http://vault:8200
# Mode selector. BLANK -- there is no dev root token to put here anymore;
# set this only to hand vault-bootstrap a manually-minted token instead of
# letting it read the one in the vault-init volume.
VAULT_TOKEN=
# Locally this value is PINNED: vault-bootstrap writes it as the role's
# role_id (AIZZAK_APPROLE_ROLE_ID), so this file and Vault cannot disagree
# on a first-ever boot or after a wiped vault-data volume re-creates the
# role. In a real deployment, leave the pin out and paste the role_id
# Vault generated.
VAULT_ROLE_ID=aizzak-local-app

# ---------------------------------------------------------------------------
# Grafana (Wave 0 step 0.3). Defaults to Grafana's own admin/admin, which is
# acceptable ONLY because the service is bound to 127.0.0.1. Change it before
# this stack is reachable from anything else -- the dashboards read every
# metric the platform emits.
# ---------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# ---------------------------------------------------------------------------
# Host port publications. The native infrastructure was removed; these
# offsets remain the stable local operator/test interface of the Compose
# stack. Containers still use canonical service ports inside the network.
# ---------------------------------------------------------------------------
HOST_PORT_HTTP=80
HOST_PORT_HTTPS=443
HOST_PORT_POSTGRES=15432
HOST_PORT_PGBOUNCER=16432
HOST_PORT_REDIS=16379
HOST_PORT_MINIO=19000
HOST_PORT_MINIO_CONSOLE=19001
HOST_PORT_QDRANT=16333
HOST_PORT_VAULT=18200
# Grafana (Wave 0 step 0.3). The ONLY observability service with a host
# publication, and loopback-only like every other line above: Prometheus and
# the two exporters stay `expose`-only on the Compose network, because a
# scraper's view of the Outbox, the DLQ and every request served is operator
# information (docs/capacity-plan.md §0.3, src/app/api/metrics.py's docstring).
HOST_PORT_GRAFANA=13000

# Gunicorn worker processes for the `app` service.
#
# ⚠️ RAISING THIS SPENDS POSTGRES CONNECTIONS, and the two deployments have
# very different room for it. Each sibling opens `DB_POOL_SIZE + DB_MAX_OVERFLOW`
# (30) for `app_rw` plus 4 more for `metrics_reader`, so the ceiling is 14 on the
# Compose stack (pgbouncer multiplexes) and only 5 on the RunPod image (no pooler
# at all -- and 2, the shipped default, on a Pod whose volume predates
# `max_connections = 200`). The full ledger, and the arithmetic behind those
# numbers, is docs/design/08-local-runbook.md §2‑ب; capacity step 2.3 guards it
# in tests/unit/test_connection_budget.py.
WEB_CONCURRENCY=2
# Which single Streams consumer to run: knowledge | media | memory.
#
# ⚠️ THIS NO LONGER AFFECTS DOCKER COMPOSE AT ALL (docs/log/3.133.md). The
# one `worker` service parameterised by this variable was split into three --
# `worker-memory`, `worker-knowledge`, `worker-media` -- each hardcoding its
# own literal `WORKER`, so `docker compose up -d` now runs the memory and
# knowledge consumers together and this line is not consulted. That is a
# deliberate simplification, not an oversight: while the value was
# interpolated, Compose's auto-loading of `.env` meant THIS file silently
# beat docker-compose.yml's own fallback, and the only way to learn what
# actually ran was `docker compose config` (release-blockers-plan.md §3
# step 3). A literal cannot be overridden, so that class of surprise is gone.
#
# Where it still decides something: the RunPod single-container image
# (deploy/runpod/entrypoint.sh sources this file and runs ONE worker under
# supervisord) and a bare `python -m app.workers.main`. `memory` is the
# default there because it has the longest live container record
# (docs/log/3.83.md, then 138 s idle with 0 restarts in docs/log/3.105.md).
# Keep it equal to deploy/runpod/entrypoint.sh's own `${WORKER:-memory}`;
# tests/unit/test_deploy_worker_default.py fails if the two drift.
WORKER=memory

# FIREBASE_PROJECT_ID is REQUIRED at boot from 2.7 onward: FirebaseAuth fails fast (ValidationError) on empty.
FIREBASE_PROJECT_ID=
FIREBASE_JWKS_CACHE_TTL=3600

# capacity-plan 1.1 -- the resolved-principal cache on the authentication
# path (workspace, user, roles, active), keyed by the Firebase subject.
# The four platform-admin routes that can change any of those invalidate it
# explicitly, so this is the backstop for a FAILED invalidation, not the
# mechanism. Ceiling 300. `0` builds no cache at all -- set it to 0 for a
# baseline measurement, so the run pays not even a Redis round trip.
AUTH_PRINCIPAL_CACHE_TTL_S=60

# capacity-plan 1.2 -- the request ceilings, enforced after authentication and
# against the USER, not the IP (nginx's per-IP `limit_req` is the flood shield
# in front, and stays underneath). `false` builds NO limiter at all, which is
# what a baseline measurement needs.
#
# It governs capacity-plan 1.3's HEAVY-JOB ceiling too (07 §4's 30 job/min on
# the four operations that answer 202), and ONE switch on purpose: a baseline
# taken with half the guard installed measures a shape the platform never runs
# in, and a second flag is exactly how a deployment ends up in one.
API_RATE_LIMIT_ENABLED=true
# The TENANT ceiling, the one 07 §4 never declared. Deliberately below the
# 6,000/min that fifty users each inside their own 120 would reach between
# them: a workspace ceiling above that number would never bind. The per-user
# number is `Limits.api_rate_per_min` (120) and is not env-editable -- it is a
# declared 07 §4 guardrail, not a deployment decision.
WORKSPACE_RATE_PER_MIN=2400
# The per-PROCESS burst guard: how many HTTP requests one worker will hold at
# once before answering 429 instead of queueing. Per process, not per replica
# -- gunicorn defaults to two workers, so a replica's real ceiling is twice
# this. `0` installs no guard at all.
MAX_IN_FLIGHT_REQUESTS=64

# Ollama: the platform's sole local LLMProvider (DD-13, 2.8-a) -- no API key.
# From inside a container the host's Ollama is host.docker.internal, not localhost.
# 11434 is the cross-platform fallback. On this WSL host the local `.env`
# deliberately uses :11435, the `ollama-bridge` listener that forwards to the
# native WSL service on 127.0.0.1:11434.
OLLAMA_BASE_URL=http://host.docker.internal:11434

EVENT_STREAM_PREFIX=stream.
OUTBOX_POLL_INTERVAL_MS=500
CONSUMER_BLOCK_MS=5000
MAX_RETRIES_BEFORE_DLQ=5
# outbox_relay process only (5.1-ب): rows per fetch/publish cycle.
OUTBOX_RELAY_BATCH_SIZE=256
# knowledge/media/memory worker processes only (5.1-ج): COUNT per XREADGROUP.
CONSUMER_BATCH_COUNT=16
# Retained length per stream —  (7.3). Redis Streams are
# append-only: XACK clears a consumer group's pending list, it does NOT delete
# the entry, so without a cap every stream.<module> grows forever even when all
# three workers run and ack perfectly. Redis here has maxmemory=0/noeviction,
# so nothing underneath catches it either.
# ⚠️ Trimming CAN drop entries a stalled consumer has not read (the outbox row
# is already marked published), which is why this is generous, not tight —
# watch XLEN (08 §7) rather than treating the cap as the answer.
# 0 disables trimming entirely = the pre-7.3 behaviour.
STREAM_MAXLEN=100000

# ── Forgetting dead consumers and groups (ت‑2, docs/operational-findings.md §2)
# Redis never forgets on its own: a consumer entry created by a worker's first
# XREADGROUP outlives the process forever, and so does a cg.notify.<host>.<pid>
# group whose API container is gone. Left alone, XINFO GROUPS/CONSUMERS fills
# with dead names — and any entries still pending against a dead consumer are
# redelivered to NOBODY, because the recovery read is scoped to the consumer
# name that died with the process.
#
# Two sweeps close it, and neither subsumes the other: a clean SIGTERM
# deregisters exactly and immediately (workers/lifecycle.py), while these
# timers cover the SIGKILL/OOM/power-loss case eventually but unconditionally.
# 0 disables a sweep (it does NOT mean "always").
#
# Worker processes only — the API's notify bridge never consumer-sweeps, since
# it would race its own registration. How often each live worker looks for dead
# siblings in the groups it reads:
CONSUMER_SWEEP_INTERVAL_S=300
# ⚠️ A DEATH THRESHOLD, not a poll interval: a consumer idle longer than this
# is declared dead and deleted. An idle worker's clock resets only every
# CONSUMER_BLOCK_MS (5 s), and a legitimate handler may run for minutes, so
# this must stay FAR above both — a tight value would delete live workers.
# Pending entries are XAUTOCLAIM-ed onto a live consumer first, and the delete
# is refused outright if any survive the claim, so no message is ever dropped.
CONSUMER_STALE_IDLE_S=900
# API process only: how often it destroys cg.notify.* groups whose owning
# process is provably gone. Never touches the four static topology groups —
# destroying one of those would reset its delivery position to the stream tail.
NOTIFY_GROUP_SWEEP_INTERVAL_S=900

# ── Reporting a dead-letter backlog (ت‑6, docs/operational-findings.md §6) ──
# Worker processes only: how often each one reads the DLQs of the streams it
# consumes (XLEN + one XRANGE, never a consuming read) and logs one
# `dlq.backlog` WARNING per non-empty queue — depth, the oldest entry's id, its
# AGE, its failure reason, and the `python -m app.ops.dlq peek <stream>` command
# to triage it. Empty queues log nothing, so silence here is the healthy state.
#
# Nothing drains a DLQ automatically and nothing here ever will: an automatic
# consumer could only re-run the handler that already failed
# MAX_RETRIES_BEFORE_DLQ times (a poison loop) or discard the entry. This
# reports; an operator decides. 0 disables the report only — dead-lettering
# itself is unaffected.
DLQ_WATCH_INTERVAL_S=300

# ── Liveness of the port-less processes (ت‑3, docs/operational-findings.md §3)
# The three worker-* consumers and outbox-relay listen on nothing, so their
# Docker healthcheck reads a file instead of curling an endpoint: each stamps
# <HEARTBEAT_DIR>/<name>.heartbeat once per completed loop cycle, and
# `python -m app.ops.healthcheck <name>` exits non-zero once that stamp is
# older than HEARTBEAT_MAX_AGE_S.
#
# Empty HEARTBEAT_DIR disables the file entirely — the right setting for a
# worker run straight from a shell, where no healthcheck is watching. The
# checker then exits 2 ("nothing to read") rather than passing vacuously.
HEARTBEAT_DIR=/tmp/aizzak-heartbeat
# ⚠️ TOLERANCE, not cadence: a worker beats every CONSUMER_BLOCK_MS (5 s) when
# idle. This is large because a beat cannot land while a handler is still
# running, and a legitimate handler may run for minutes — a threshold that
# flagged a busy worker as unhealthy would train operators to ignore the
# column. docker-compose.yml raises it to 600 for worker-media alone
# (image generation, Limits.media_timeout_s = 300).
HEARTBEAT_MAX_AGE_S=300

# JSON routing table (D-16, FR-73): capability/agent -> provider + model.
# Namespaces: "llm" (any capability key + reserved "default"), "embedding" and
# "image" ("default" only -- neither port takes a capability). Every entry is
# an object with exactly {"provider","model"} -- the 2.9 resolver validates
# this shape at construction and refuses to boot on anything else (a bare
# provider string carries no model to resolve).
#
# "image" became usable in step 19 of docs/deferred-adapters-plan.md and is now
# routed below. Note its provider name: "image:openai", NOT "openai". That is
# 06-domain-models §3's <modality>:<name> key, and it is the name a credential
# is stored under -- routing an image job at plain "openai" would look right,
# boot fine, and then fail every generation with credentials.provider_unknown.
# It also means an image key and a chat key are separate credentials, which is
# what you want if only one of them is entitled to image generation.
# Step 20 wired the media WORKER over this same route, so it is now the line
# that process resolves its provider through; the API and the knowledge
# worker are unaffected by it.
# "video" is not a namespace at all yet (same plan, §2's scope note).
PROVIDER_ROUTING={"llm":{"default":{"provider":"openai","model":"gpt-5.4-mini"}},"embedding":{"default":{"provider":"embedding-local","model":"sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"}},"image":{"default":{"provider":"image:openai","model":"gpt-image-1"}}}

OAUTH_REDIRECT_BASE_URL=
MCP_ALLOWED_TRANSPORTS=http,sse
OAUTH_REFRESH_SKEW_S=60

USAGE_ROLLUP_PERIODS=day,month
USAGE_DEFAULT_LIMITS={"tokens":{"month":5000000},"cost_micros":{"month":50000000}}
